# Template for .env: copy to .env and fill in. Load with:
#   set -a; source .env; set +a
# Every variable is validated at startup; see the Configuration table in README.md.
# Optional variables are shown with their defaults.

# --- Jenkins (in-boundary) ---
JENKINS_URL=<JENKINS_URL>                 # required; e.g. https://jenkins.example.internal
JENKINS_USER=<JENKINS_USER>               # required; a dedicated service account, not a personal user
JENKINS_API_TOKEN=<JENKINS_API_TOKEN>     # required; basic auth for reads and the trigger POST
JENKINS_JOB_ALLOWLIST=example-job         # required; comma-separated, no spaces; must include the govcloud.ci/jenkins-job value
# JENKINS_JOB_TOKEN is not supported and must not be set.

# --- S3 (GovCloud) ---
S3_BUCKET=<S3_BUCKET>                     # required
S3_REGION=us-gov-west-1
S3_ENDPOINT=                              # optional override (e.g. VPC endpoint); empty = the region's FIPS endpoint (s3-fips.*)
S3_USE_PATH_STYLE=false                   # usually true with S3_ENDPOINT
# AWS credentials come from the SDK default chain (env vars, AWS_PROFILE, IRSA, instance role):
AWS_ACCESS_KEY_ID=<AWS_ACCESS_KEY_ID>
AWS_SECRET_ACCESS_KEY=<AWS_SECRET_ACCESS_KEY>

# --- Prow (public feed, no auth) ---
PROW_JOBS_URL=https://prow.ci.openshift.org/prowjobs.js
EXECUTOR_LABEL=govcloud-jenkins
PROW_FEED_TIMEOUT=5m                      # deadline for one feed request
PROW_FEED_MAX_BYTES=1073741824            # 1 GiB; a larger feed is a failed poll

# --- loop tuning ---
POLL_INTERVAL=30s                         # 1s to 10m
FEED_ABSENT_POLLS=10                      # polls an in-flight ProwJob must be missing before its build is stopped
MAX_BUILD_TIME=2h                         # give-up time per run (README, Timeouts and stopping builds)
MAX_LOG_BYTES=52428800                    # 50 MiB; longer console logs are cut to their tail
MAX_ARTIFACT_BYTES=104857600              # 100 MiB per archived artifact; larger ones are skipped
MAX_TOTAL_ARTIFACT_BYTES=1073741824       # 1 GiB of archived artifacts per build
MAX_ARTIFACTS=500                         # archived artifacts copied per build; the rest are skipped
SHUTDOWN_TIMEOUT=30s                      # drain time for the step in progress at SIGTERM/SIGINT
